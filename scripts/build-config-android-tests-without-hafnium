# This file lists tests that run with a full Android userspace present.
# These tests don't work on Hafnium, so they are only included for builds that
# don't enable Hafnium.

[
    # stdcall test with large shared memory buffers.
    # Each test run takes up to 4 arguments:
    # <obj_size>,<obj_count=1>,<repeat_share=1>,<repeat_access=3>
    #
    # Test 10 8MB objects, shared twice, each accessed twice. (8MB non-
    # contiguous object is large enough to need several 4KB messages to
    # describe)
    # Test sharing 2 8MB objects 100 times without accessing it.
    #
    # TODO: enable these on Hafnium when we support the new
    # EMAD v1.2 layout, and fragmented (multi-page) share/retrieve
    # requests work correctly on Hafnium.
    androidtest(name="stdcalltest-large",
                command="echo '"
                        "0x800000,10,2,2 "
                        "0x800000,2,100,0 "
                        "' >"
                        "$(echo /sys/bus/platform/devices/"
                        "?(*:)trusty?(-core):test/trusty_test_run)"),
]