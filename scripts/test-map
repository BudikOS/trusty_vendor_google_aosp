                                "echo 0 >/sys/module/trusty_core/parameters/use_high_wq"
                                ";"
                                "timeout 10 trusty-ut-ctrl com.android.kernel.busy-test"
                                ";"
                                "echo 1 > /sys/module/trusty_core/parameters/use_high_wq"
                                ";"
                                "timeout 10 trusty-ut-ctrl com.android.kernel.busy-test"
                                ";"
                                "echo 0 >/sys/module/trusty_core/parameters/use_high_wq"
                                "&&"
                                "wait"),

